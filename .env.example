# Green Fay Farm Foods - Environment Configuration
APP_ENV=production
APP_SECRET=replace-with-secure-random-secret-key-64-characters
PORT=8000
HOST=0.0.0.0

# Database URL
# For local development (SQLite):
DATABASE_URL=sqlite:///./greenfay.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://greenfay_user:greenfay_secure_pass@localhost:5432/greenfay_db

# Security & Initial Admin (Production)
INITIAL_ADMIN_PASSWORD=GF#Admin2026!Secure
MAX_UPLOAD_SIZE=10485760

# File Storage
UPLOAD_DIR=uploads
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
